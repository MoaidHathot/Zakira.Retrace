<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    CI only. The repository's NuGet.config deliberately declares no sources of its own: it maps
    every package to the corporate proxy feeds that developer machines already have in their
    user-level config, because api.nuget.org is unreachable from those machines. GitHub's runners
    are the mirror image, with nuget.org and nothing else, so the workflow restores with the
    configfile option pointing here, which makes NuGet use this file and only this file.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
