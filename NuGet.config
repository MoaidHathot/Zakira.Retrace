<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    There is deliberately no <clear /> and no re-added `nuget.org`. This machine cannot reach
    `api.nuget.org` directly — it is blocked at the TLS layer — and gets public packages through
    the approved `azure-default` proxy instead. The user-level NuGet.Config already declares that
    proxy (along with the private `ZTS` feed and a local folder feed) and disables `nuget.org`, so
    inheriting it is both correct and the convention the sibling Zakira repos follow.

    The mapping below exists because this repo uses central package management. With more than one
    source in play and no mapping, restore fails with NU1507. Mapping every pattern to the three
    reachable feeds keeps restore deterministic about where a package may come from without
    pretending some subset of our dependencies is private: they are all public packages served by
    the proxy, with `ZTS` and `local` available for locally produced Zakira artifacts.
  -->
  <packageSourceMapping>
    <packageSource key="azure-default">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ZTS">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
